rules_version = '2';

// Roles are read live from the caller's own users/{uid} document — never from a client-
// supplied field on the document being written, and never from a custom claim on the auth
// token. A claim would need a separate Cloud Function to stay in sync and would only take
// effect on the client's next token refresh (up to ~1hr, or the next sign-in), so a role
// change made here takes effect immediately instead. get() calls below all target the same
// document path, which Firestore's rules engine caches for the duration of one request, so
// this doesn't multiply the read cost of a rule check.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function callerRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "public";
    }
    function isAdmin() {
      return callerRole() == "admin";
    }
    function isReviewer() {
      return callerRole() in ["reviewer", "admin"];
    }
    function isResearcher() {
      return callerRole() in ["researcher", "reviewer", "admin"];
    }
    function isOwner(data) {
      return signedIn() && data.createdBy == request.auth.uid;
    }
    // Researchers may only create/save records in draft or review; only a reviewer/admin
    // may move a record to "published" or "archived" (spec section 10, steps 6-7).
    function publicationTransitionAllowed(newStatus) {
      return newStatus in ["draft", "review"] ? isResearcher() : isReviewer();
    }

    // Politicians only: any signed-in user (not just researcher+) may submit and keep
    // editing their own record while it's in draft or review — publishing/archiving still
    // requires reviewer+ regardless of ownership. This is what lets a newly registered
    // account use the "Add politician" button immediately, without needing to first be
    // promoted to researcher.
    function ownDraftOrReviewAllowed(newStatus, isRecordOwner) {
      return newStatus in ["draft", "review"] ? (isRecordOwner || isResearcher()) : isReviewer();
    }

    match /politicians/{politicianId} {
      allow read: if resource.data.publicationStatus == "published" || isResearcher() || isOwner(resource.data);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && ownDraftOrReviewAllowed(request.resource.data.publicationStatus, true);
      allow update: if (isOwner(resource.data) || isReviewer())
        && ownDraftOrReviewAllowed(request.resource.data.publicationStatus, isOwner(resource.data));
      allow delete: if isAdmin();
    }

    match /politicalPositions/{positionId} {
      // Career history carries no allegations (unlike cases/claims/investigations, which
      // are always gated on publicationStatus), so it is not treated as sensitive.
      allow read: if true;
      allow create: if isResearcher() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isOwner(resource.data) || isReviewer();
      allow delete: if isAdmin();
    }

    match /cases/{caseId} {
      allow read: if resource.data.publicationStatus == "published" || isResearcher();
      allow create: if isResearcher()
        && request.resource.data.createdBy == request.auth.uid
        && publicationTransitionAllowed(request.resource.data.publicationStatus);
      allow update: if (isOwner(resource.data) || isReviewer())
        && publicationTransitionAllowed(request.resource.data.publicationStatus);
      allow delete: if isAdmin();
    }

    match /investigations/{investigationId} {
      allow read: if resource.data.publicationStatus == "published" || isResearcher();
      allow create: if isResearcher()
        && request.resource.data.createdBy == request.auth.uid
        && publicationTransitionAllowed(request.resource.data.publicationStatus);
      allow update: if (isOwner(resource.data) || isReviewer())
        && publicationTransitionAllowed(request.resource.data.publicationStatus);
      allow delete: if isAdmin();
    }

    match /legalEvents/{eventId} {
      allow read: if resource.data.publicationStatus == "published" || isResearcher();
      allow create: if isResearcher()
        && request.resource.data.createdBy == request.auth.uid
        && publicationTransitionAllowed(request.resource.data.publicationStatus);
      allow update: if (isOwner(resource.data) || isReviewer())
        && publicationTransitionAllowed(request.resource.data.publicationStatus);
      allow delete: if isAdmin();
    }

    match /claims/{claimId} {
      allow read: if resource.data.reviewStatus == "approved" || isResearcher();
      allow create: if isResearcher() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isOwner(resource.data) || isReviewer();
      allow delete: if isAdmin();
    }

    match /sources/{sourceId} {
      allow read: if isResearcher() || resource.data.verificationStatus == "verified";
      allow create: if isResearcher() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isOwner(resource.data) || isReviewer();
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if resource.data.status == "published" || isResearcher();
      allow create: if isResearcher()
        && request.resource.data.createdBy == request.auth.uid
        && publicationTransitionAllowed(request.resource.data.status);
      allow update: if (isOwner(resource.data) || isReviewer())
        && publicationTransitionAllowed(request.resource.data.status);
      allow delete: if isAdmin();
    }

    match /correctionRequests/{requestId} {
      // Anyone — including the anonymous public — can report an error on a published
      // profile (spec section 17); only a reviewer/admin can read the queue or resolve it.
      allow read: if isReviewer();
      allow create: if request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() < 2000
        && request.resource.data.status == "open";
      allow update: if isReviewer();
      allow delete: if isAdmin();
    }

    match /auditLogs/{auditLogId} {
      allow read: if isAdmin();
      // Append-only: any signed-in user may log their own action; nobody may forge another actor's entry.
      allow create: if signedIn() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    match /settings/{settingId} {
      // Admin-controlled feature flags and similar app config — publicly readable so
      // navigation can be gated for everyone, writable only by an admin.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      // New accounts self-provision at the lowest privilege level only.
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == "public"
        && request.resource.data.isActive == true;
      // A user may edit their own profile but can never change their own role or active
      // flag — only an admin can promote/demote or deactivate an account.
      allow update: if isAdmin()
        || (
          signedIn() && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.isActive == resource.data.isActive
        );
      // A user may delete their own account's profile doc (self-service account deletion);
      // an admin may remove anyone's.
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }
  }
}
