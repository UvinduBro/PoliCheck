rules_version = '2';

// Roles are read live from the caller's own Firestore users/{uid} document via the
// cross-service firestore.get()/firestore.exists() rules functions — never from a custom
// claim on the auth token, which would only take effect on the client's next token refresh.
// See firestore.rules for the matching rationale on the Firestore side.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function callerRole() {
      return signedIn() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : "public";
    }
    function isResearcher() {
      return callerRole() in ["researcher", "reviewer", "admin"];
    }
    function isAdmin() {
      return callerRole() == "admin";
    }

    function isAllowedType() {
      return request.resource.contentType.matches("application/pdf")
        || request.resource.contentType.matches("image/png")
        || request.resource.contentType.matches("image/jpeg")
        || request.resource.contentType.matches("image/webp");
    }

    function isUnderSizeLimit() {
      return request.resource.size < 25 * 1024 * 1024;
    }

    // research/{politicians|cases|sources|reports}/{entityId}/{fileName}
    match /research/{kind}/{entityId}/{fileName} {
      allow read: if true;
      allow write: if isResearcher() && isAllowedType() && isUnderSizeLimit();
      allow delete: if false;
    }

    // research/user-uploads/{uid}/{fileName} — private working files, owner + admin only.
    match /research/user-uploads/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid && isAllowedType() && isUnderSizeLimit();
      allow delete: if false;
    }

    // User profile images.
    match /research/profile-images/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
        && (request.resource.contentType.matches("image/png") || request.resource.contentType.matches("image/jpeg") || request.resource.contentType.matches("image/webp"))
        && isUnderSizeLimit();
      allow delete: if false;
    }

    match /{allOtherPaths=**} {
      allow read, write: if false;
    }
  }
}
